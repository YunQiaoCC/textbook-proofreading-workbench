server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name proofread.kycloudmimi.site;

    root /home/ubuntu/textbook-proofreading-workbench/dist;
    index index.html;
    client_max_body_size 32m;

    ssl_certificate /etc/letsencrypt/live/proofread.kycloudmimi.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proofread.kycloudmimi.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Certbot's nginx authenticator must be able to complete HTTP-01 without
    # the shared workbench credential. Certbot may add a more specific
    # temporary location while renewing.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }

    # Public, self-contained Friday report. Keep it outside the workbench
    # build directory so application deploys cannot overwrite the page.
    location = /social-law {
        return 301 /social-law/;
    }

    location ^~ /social-law/ {
        root /var/www;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # Keep /api in the upstream URI. The API also needs the original request
    # context. Authorization is cleared; the application authenticates only
    # with its opaque HttpOnly session cookie.
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 420s;
        proxy_send_timeout 420s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
    }

    # Keep hashed PDF.js worker modules as real static assets. Do not let
    # missing .mjs assets fall through to the SPA index.html.
    location ~* ^/assets/.*\.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name proofread.kycloudmimi.site;

    # Keep the challenge path reachable while redirecting all other HTTP
    # traffic to HTTPS. This is intentionally unauthenticated for renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
