[Unit]
Description=Textbook proofreading Node API
After=network.target

[Service]
EnvironmentFile=-/etc/legal-textbook-proofreading-workbench/deepseek.env
Type=simple
User=workbench
Group=workbench
WorkingDirectory=/opt/legal-textbook-proofreading-workbench
ExecStart=/usr/bin/node /opt/legal-textbook-proofreading-workbench/server/app.mjs
EnvironmentFile=-/etc/legal-textbook-proofreading-workbench/yuandian.env
EnvironmentFile=/etc/legal-textbook-proofreading-workbench/auth.env
Environment=NODE_ENV=production
Environment=WORKBENCH_AUTH_REQUIRED=1
Environment=DOCUMENT_API_HOST=127.0.0.1
Environment=DOCUMENT_API_PORT=8787
Environment=DOCUMENT_STORAGE_ROOT=/var/lib/legal-textbook-proofreading-workbench
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
