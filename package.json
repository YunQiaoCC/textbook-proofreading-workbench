    "inspect:pdf": "node scripts/inspect-pdf.mjs",
    "test:inspect-pdf": "node scripts/test-inspect-pdf.mjs",
    "test:ingestion": "node scripts/test-ingestion.mjs",
    "test:duplicate-upload": "node scripts/test-duplicate-upload.mjs",
    "test:document-read": "node scripts/test-document-read.mjs",
    "test:proofreading": "node scripts/test-proofreading.mjs",
    "test:chapters": "node scripts/test-chapters.mjs",
    "test:document-delete": "node scripts/test-document-delete.mjs",
    "test:issue-delete": "node scripts/test-issue-delete.mjs",
    "test:text-extraction": "node scripts/test-text-extraction.mjs",
    "test:legal-skill": "node scripts/validate-legal-proofreading-skill.mjs",
    "test:ai-review-workflow": "node scripts/test-ai-review-workflow.mjs",
    "test:workflow-rollback": "node scripts/test-workflow-rollback.mjs",
    "test:ai-candidate-overlays": "node scripts/test-ai-candidate-overlays.mjs",
    "test:ai-candidate-overlay": "node scripts/test-ai-candidate-overlays.mjs && node scripts/test-ui-layer-clickability.mjs",
