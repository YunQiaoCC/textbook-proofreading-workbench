# Local API defaults
DOCUMENT_API_HOST=127.0.0.1
DOCUMENT_API_PORT=8787
DOCUMENT_STORAGE_ROOT=./storage
MAX_DOCUMENT_SIZE=1073741824
UPLOAD_CHUNK_SIZE=16777216
INSPECTION_TIMEOUT_MS=300000

# Shared authentication. Replace both placeholders when enabling auth.
WORKBENCH_AUTH_REQUIRED=0
WORKBENCH_ACCESS_USERNAME=replace-with-shared-username
WORKBENCH_ACCESS_PASSWORD=replace-with-a-long-random-password

# Login-only in-memory rate limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX_IDENTITIES=10000

# Optional Poppler executable overrides
PDFINFO_BIN=
PDFTOTEXT_BIN=
PDFTOPPM_BIN=

# Optional AI review integration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=120000
AI_REVIEW_MAX_CHAPTER_CHARS=500000

# Optional legal-source retrieval integration
YUANDIAN_API_KEY=
YUANDIAN_LAW_MCP_URL=https://open.chineselaw.com/mcp/law/stream
YUANDIAN_MCP_TIMEOUT_MS=20000

# Development-only browser proxy
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
